DirectoryIndex index.html

RewriteEngine On

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# /index/pagina.html -> /index/pagina
RewriteCond %{THE_REQUEST} \s/(index/[^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# /index/pagina -> sirve /index/pagina.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(index/[^.]+)$ $1.html [L]
