DirectoryIndex index.html

RewriteEngine On

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# URLs antiguas /index/pagina(.html) -> /pagina
RewriteCond %{THE_REQUEST} \s/index/([^\s?.]+)(\.html)?[\s?]
RewriteRule ^ /%1 [R=301,L]

# /pagina -> sirve index/pagina.html
RewriteRule ^(peliculas|galeria|Reconocimiento|noticias|contacto)/?$ index/$1.html [L]
